import { useState } from 'react'
import { useAuth } from '../../lib/AuthContext'
import { useToast } from '../../lib/ToastContext'
import { useBeneficiaryContacts } from '../../hooks/useBeneficiaryContacts'
import { useContactMutations } from '../../hooks/useContactMutations'
import { useContacts } from '../../hooks/useContacts'
import SearchableSelect from '../../components/common/SearchableSelect'
import ContactEditorModal from '../contacts/ContactEditorModal'

const pickerClass = 'w-full border border-gray-300 rounded px-2 py-1.5 text-base sm:text-sm focus:outline-none focus:ring-2 focus:ring-blue-500'

// Mounted only while "Link existing" is open, so the full contacts list is
// fetched on demand rather than every time a beneficiary is opened.
function LinkExisting({ excludeIds, onLink, onCancel }) {
  const { contacts, loading } = useContacts()
  const [selected, setSelected] = useState('')
  const [busy, setBusy] = useState(false)

  const options = contacts
    .filter(c => !excludeIds.has(c.id))
    .map(c => {
      const others = c.beneficiaries.map(b => b.name).join(', ')
      return { value: c.id, label: [c.name, c.role].filter(Boolean).join(' — ') + (others ? ` (${others})` : '') }
    })

  async function go() {
    setBusy(true)
    await onLink(Number(selected))
    setBusy(false)
  }

  if (loading) return <p className="text-xs text-gray-400">Loading contacts...</p>
  return (
    <div className="flex gap-2 items-start">
      <div className="flex-1 min-w-0">
        <SearchableSelect
          value={selected}
          onChange={setSelected}
          options={options}
          placeholder="Select a contact..."
          searchPlaceholder="Search contacts..."
          emptyText="No other contacts"
          className={pickerClass}
        />
      </div>
      <button onClick={go} disabled={!selected || busy} className="bg-blue-600 text-white rounded px-3 py-1.5 text-xs font-medium hover:bg-blue-700 disabled:opacity-50 flex-shrink-0">
        {busy ? '...' : 'Link'}
      </button>
      <button onClick={onCancel} className="border border-gray-300 rounded px-3 py-1.5 text-xs hover:bg-gray-50 flex-shrink-0">Cancel</button>
    </div>
  )
}

// Contacts section of the beneficiary edit modal: list, edit, create (+ New
// contact, pre-linked to this beneficiary), link an existing contact, unlink.
export default function BeneficiaryContacts({ beneficiary }) {
  const { canEdit } = useAuth()
  const toast = useToast()
  const { contacts, loading, refetch } = useBeneficiaryContacts(beneficiary.id)
  const { saveContact, linkContact, unlinkContact, deleteContact } = useContactMutations()

  const [editing, setEditing] = useState(null) // a contact | 'new' | null
  const [linking, setLinking] = useState(false)
  const [error, setError]     = useState(null)

  async function handleSave(payload) {
    const isNew = editing === 'new'
    const result = await saveContact(isNew ? null : editing.id, payload)
    if (result.error) return { error: result.error }
    await refetch()
    toast.success(isNew ? 'Contact added' : 'Contact updated')
    return { error: null }
  }

  async function handleDelete(id) {
    const result = await deleteContact(id)
    if (result.error) return result
    await refetch()
    setEditing(null)
    toast.success('Contact deleted')
    return { error: null }
  }

  async function handleLink(contactId) {
    setError(null)
    const { error } = await linkContact(contactId, beneficiary.id)
    if (error) { setError(error); return }
    await refetch()
    setLinking(false)
    toast.success('Contact linked')
  }

  async function handleUnlink(c) {
    if (!window.confirm(`Unlink ${c.name} from ${beneficiary.name}? The contact itself is kept.`)) return
    setError(null)
    const { error } = await unlinkContact(c.id, beneficiary.id)
    if (error) { setError(error); return }
    await refetch()
    toast.success('Contact unlinked')
  }

  return (
    <div className="pt-2 border-t border-gray-100">
      <div className="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Contacts</div>

      {loading ? (
        <p className="text-xs text-gray-400">Loading contacts...</p>
      ) : contacts.length === 0 ? (
        <p className="text-xs text-gray-400 mb-2">No contacts yet.</p>
      ) : (
        <div className="space-y-1.5 mb-2">
          {contacts.map(c => (
            <div key={c.id} className="flex items-center justify-between gap-2 bg-gray-50 rounded px-3 py-2">
              <div className="min-w-0">
                <div className="text-sm text-gray-700 truncate">{c.name}</div>
                <div className="text-xs text-gray-400 truncate">
                  {[c.role, c.contact_number].filter(Boolean).join(' · ') || '—'}
                </div>
              </div>
              {canEdit && (
                <div className="flex items-center gap-3 flex-shrink-0">
                  <button onClick={() => setEditing(c)} className="text-xs text-blue-500 hover:text-blue-700 underline">Edit</button>
                  <button onClick={() => handleUnlink(c)} className="text-xs text-red-400 hover:text-red-600">Unlink</button>
                </div>
              )}
            </div>
          ))}
        </div>
      )}

      {error && <p className="text-red-500 text-xs mb-2">{error}</p>}

      {canEdit && (linking ? (
        <LinkExisting
          excludeIds={new Set(contacts.map(c => c.id))}
          onLink={handleLink}
          onCancel={() => setLinking(false)}
        />
      ) : (
        <div className="flex items-center gap-4">
          <button onClick={() => setEditing('new')} className="text-xs text-blue-500 hover:text-blue-700 underline">+ New contact</button>
          <button onClick={() => setLinking(true)} className="text-xs text-blue-500 hover:text-blue-700 underline">Link existing</button>
        </div>
      ))}

      {editing && (
        <ContactEditorModal
          contact={editing === 'new' ? null : editing}
          defaultBeneficiaryId={beneficiary.id}
          onSave={handleSave}
          onDelete={editing === 'new' ? undefined : handleDelete}
          onClose={() => setEditing(null)}
        />
      )}
    </div>
  )
}